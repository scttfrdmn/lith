# Build artifacts
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# Local index files and caches
*.lith
*.lithidx
# ...but the committed golden 1.0.x index fixtures are tracked (the 1.x
# compatibility guard, #196). Regenerate only for a deliberate format change.
!/internal/index/testdata/golden/*.lith
/cache/

# Host-specific NIC baseline cache (code writes nic-<uid>.json)
nic*.json

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
site/

# Built binary (produced by `go build`; the release binary comes from goreleaser)
/lith
